{
  servers {
    protocols h1 h2 h3
  }
}

{$PUBLIC_DOMAIN} {
  encode zstd gzip
  header {
    -Server
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
  }
  reverse_proxy app:3000 {
    health_uri /health/ready
    health_interval 30s
    health_timeout 5s
  }
  log {
    output stdout
    format json
  }
}
